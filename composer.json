{
    "name": "zendscape/zendscape",
    "description": "Interactive 3D explorer for PHP memory snapshots",
    "type": "project",
    "license": "MIT",
    "bin": [
        "backend/bin/zendscape"
    ],
    "require": {
        "php": "^8.4.1",
        "ext-ffi": "*",
        "ext-pcntl": "*",
        "amphp/http-server": "^3",
        "reliforp/reli-prof": "0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Zendscape\\": "backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zendscape\\Tests\\": "backend/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "lint": [
            "php-cs-fixer check --diff --config=backend/.php-cs-fixer.dist.php",
            "phpstan analyse --configuration=backend/phpstan.neon"
        ],
        "fix": "php-cs-fixer fix --config=backend/.php-cs-fixer.dist.php",
        "test": "phpunit --configuration=backend/phpunit.xml"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    }
}
